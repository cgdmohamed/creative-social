# Synthetic values for compose config only. Replace in isolated Coolify staging.
STAGING_URL=https://social-staging.example.invalid
STAGING_REVISION=reviewed-commit-sha
STAGING_DB_PASSWORD=replace-with-url-safe-random-staging-password
STAGING_JWT_SECRET=replace-with-at-least-64-random-characters
STAGING_TEMPORAL_ADDRESS=temporal-staging.example.invalid:7233
STAGING_TEMPORAL_NAMESPACE=creative-staging
STAGING_TEMPORAL_TLS=false
STAGING_TEMPORAL_API_KEY=
DISABLE_REGISTRATION=true
MAX_WORKSPACES_PER_USER=10

# Isolated advertising test apps/keys, never production credentials.
ADS_ENCRYPTION_KEY=
META_ADS_APP_ID=
META_ADS_APP_SECRET=
META_ADS_API_VERSION=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_API_VERSION=v26
INBOX_COLLECTION_ENABLED=false
REPORTING_COLLECTION_ENABLED=false
STAGING_FACEBOOK_APP_ID=
STAGING_FACEBOOK_APP_SECRET=
STAGING_INSTAGRAM_APP_ID=
STAGING_INSTAGRAM_APP_SECRET=
