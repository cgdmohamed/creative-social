ARG POSTGRES_IMAGE=postgres:17-bookworm@sha256:839fbb5a4942a7758dd93e18b42ea5649807491a0545b5eeeb8f0b8bb11857a5
FROM ${POSTGRES_IMAGE}
COPY --chmod=755 deploy/coolify/production/init-role.sh /docker-entrypoint-initdb.d/10-creative-role.sh
COPY --chmod=755 deploy/coolify/production/postgres-entrypoint.sh /opt/creative/postgres-entrypoint.sh
ENTRYPOINT ["/opt/creative/postgres-entrypoint.sh"]
CMD ["postgres"]
