# Staging candidate only. Build and boot validation still requires a Docker host.
FROM node:22.23.4-bookworm-slim AS build
RUN apt-get update && apt-get install -y --no-install-recommends python3 make g++ ca-certificates git && rm -rf /var/lib/apt/lists/*
RUN npm install -g pnpm@10.6.1
WORKDIR /app
COPY . .
ARG STAGING_URL
ENV NEXT_TELEMETRY_DISABLED=1 STORAGE_PROVIDER=local UPLOAD_DIRECTORY=/app/uploads NEXT_PUBLIC_UPLOAD_DIRECTORY=/uploads
ENV MAIN_URL=${STAGING_URL} FRONTEND_URL=${STAGING_URL} NEXT_PUBLIC_BACKEND_URL=${STAGING_URL}/api BACKEND_INTERNAL_URL=http://backend:3000
RUN test -n "$STAGING_URL" && pnpm install --frozen-lockfile && pnpm run build

FROM node:22.23.4-bookworm-slim AS runtime
RUN apt-get update && apt-get install -y --no-install-recommends chromium fonts-noto-core fonts-noto-extra ca-certificates curl && rm -rf /var/lib/apt/lists/*
WORKDIR /app
# Keep AGPL source, LICENSE and attribution with the image.
COPY --from=build --chown=node:node /app /app
RUN mkdir -p /app/uploads && chown node:node /app/uploads
ENV NODE_ENV=production NEXT_TELEMETRY_DISABLED=1 REPORT_CHROMIUM_EXECUTABLE_PATH=/usr/bin/chromium
USER node
EXPOSE 3000 4200
CMD ["node", "--experimental-require-module", "apps/backend/dist/apps/backend/src/main.js"]
