# Configuration template only: no actual credentials. Replace every CHANGE_ME.
# Coolify: import these into the resource Environment Variables, not build secrets.
PUBLIC_URL=https://social.example.invalid
CREATIVE_REVISION=replace-with-reviewed-40-character-git-commit-sha

# Generate each value independently: openssl rand -hex 32
# Both PostgreSQL admin passwords and all runtime passwords must be >=64 hex
# characters. Generate JWT_SECRET independently with the same command.
JWT_SECRET=CHANGE_ME_UNIQUE_RANDOM_SECRET_AT_LEAST_64_CHARACTERS
POSTGRES_ADMIN_PASSWORD=CHANGE_ME_SEPARATE_POSTGRES_ADMIN_PASSWORD
APP_DB_PASSWORD=CHANGE_ME_64_HEXADECIMAL_CHARACTERS
REDIS_PASSWORD=CHANGE_ME_DIFFERENT_64_HEXADECIMAL_CHARACTERS
TEMPORAL_POSTGRES_ADMIN_PASSWORD=CHANGE_ME_SEPARATE_TEMPORAL_ADMIN_PASSWORD
TEMPORAL_DB_PASSWORD=CHANGE_ME_DIFFERENT_TEMPORAL_64_HEXADECIMAL_CHARACTERS

# Explicit one-time consent for NEW EMPTY databases/namespace only. Defaults deny.
# After an approved first bootstrap, restore all three to false and redeploy.
INITIALIZE_EMPTY_DATABASE=false
INITIALIZE_EMPTY_TEMPORAL_DATABASES=false
INITIALIZE_TEMPORAL_NAMESPACE=false
TEMPORAL_NAMESPACE=creative-production
TEMPORAL_RETENTION_DAYS=30

# Temporarily false only for restricted first-admin bootstrap, then true.
DISABLE_REGISTRATION=true
# Maximum active workspaces owned by one account, including its initial one.
# 0 disables creation; existing workspaces and access remain unchanged.
MAX_WORKSPACES_PER_USER=10

# Optional, separate advertising developer apps. Generate the encryption key
# independently with openssl rand -hex 32; keep it stable and back it up securely.
ADS_ENCRYPTION_KEY=
META_ADS_APP_ID=
META_ADS_APP_SECRET=
# Set a currently supported Graph API version approved for your Meta app.
META_ADS_API_VERSION=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_API_VERSION=v26
# Remain false until real Meta permissions/accounts and responses are validated.
INBOX_COLLECTION_ENABLED=false
REPORTING_COLLECTION_ENABLED=false

# Optional publishing providers. Only backend/workers receive these secrets.
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
X_API_KEY=
X_API_SECRET=
TIKTOK_CLIENT_ID=
TIKTOK_CLIENT_SECRET=
TIKTOK_BUSINESS_CLIENT_ID=
TIKTOK_BUSINESS_CLIENT_SECRET=
PINTEREST_CLIENT_ID=
PINTEREST_CLIENT_SECRET=
THREADS_APP_ID=
THREADS_APP_SECRET=

# Optional transactional email; use nodemailer with external SMTP, or resend.
# No mail development server is deployed. Empty provider auto-activates accounts.
EMAIL_PROVIDER=
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=Creative Social
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=
EMAIL_PASS=
RESEND_API_KEY=
